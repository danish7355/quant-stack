{
  "entities": {
    "Position": {
      "title": "Position",
      "description": "An active or historical trading position",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "symbol": { "type": "string" },
        "direction": { "type": "string", "enum": ["LONG", "SHORT"] },
        "entry_price": { "type": "number" },
        "current_price": { "type": "number" },
        "quantity": { "type": "number" },
        "leverage": { "type": "number" },
        "allocated_balance": { "type": "number" },
        "tp1": { "type": "number" },
        "tp2": { "type": "number" },
        "tp3": { "type": "number" },
        "sl": { "type": "number" },
        "trailing_stop_active": { "type": "number" },
        "time_open": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "CLOSED"] }
      },
      "required": ["id", "symbol", "direction", "entry_price", "current_price", "quantity", "status"]
    },
    "TradeLog": {
      "title": "TradeLog",
      "description": "Historical closed trade log record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "symbol": { "type": "string" },
        "direction": { "type": "string", "enum": ["LONG", "SHORT"] },
        "entry_price": { "type": "number" },
        "close_price": { "type": "number" },
        "profit": { "type": "number" },
        "pct_return": { "type": "number" },
        "exit_reason": { "type": "string" },
        "time_open": { "type": "string" },
        "time_close": { "type": "string" }
      },
      "required": ["id", "symbol", "direction", "entry_price", "close_price", "profit", "time_open", "time_close"]
    },
    "BotSettings": {
      "title": "BotSettings",
      "description": "Server-side bot configuration for 24/7 background trade execution, risk parameters, and credentials",
      "type": "object",
      "properties": {
        "activeStrategy": { "type": "string" },
        "crEnabled": { "type": "boolean" },
        "crClimaxLookback": { "type": "number" },
        "crEmaFast": { "type": "number" },
        "crEmaContext": { "type": "number" },
        "crEmaBaseline": { "type": "number" },
        "crAtrPeriod": { "type": "number" },
        "crMinOverextensionAtr": { "type": "number" },
        "crMinAtrVsAverage": { "type": "number" },
        "crAtrAveragePeriod": { "type": "number" },
        "crMinRejectionWickRatio": { "type": "number" },
        "crMinClimaxRangeRatio": { "type": "number" },
        "crMinStopDistanceAtr": { "type": "number" },
        "crMinRewardRisk": { "type": "number" },
        "timeframe": { "type": "string" },
        "autoTradeThreshold": { "type": "number" },
        "coinCount": { "type": "number" },
        "autoTradeEnabled": { "type": "boolean" },
        "scanInterval": { "type": "number" },
        "theme": { "type": "string" },
        "min24hVolume": { "type": "number" },
        "maxFundingRate": { "type": "number" },
        "maxSpread": { "type": "number" },
        "emaFastPeriod": { "type": "number" },
        "emaSlowPeriod": { "type": "number" },
        "emaTrendPeriod": { "type": "number" },
        "emaCrossLookback": { "type": "number" },
        "rsiPeriod": { "type": "number" },
        "rsiLongMin": { "type": "number" },
        "rsiLongMax": { "type": "number" },
        "rsiShortMin": { "type": "number" },
        "rsiShortMax": { "type": "number" },
        "macdFast": { "type": "number" },
        "macdSlow": { "type": "number" },
        "macdSignal": { "type": "number" },
        "adxPeriod": { "type": "number" },
        "adxTrendThreshold": { "type": "number" },
        "superTrendPeriod": { "type": "number" },
        "superTrendMultiplier": { "type": "number" },
        "volumeMultiplier": { "type": "number" },
        "fibLookback": { "type": "number" },
        "atrPeriod": { "type": "number" },
        "startingBalance": { "type": "number" },
        "positionSizePct": { "type": "number" },
        "accountRiskPct": { "type": "number" },
        "leverage": { "type": "number" },
        "maxConcurrentTrades": { "type": "number" },
        "dailyLossLimitPct": { "type": "number" },
        "maxDrawdownPct": { "type": "number" },
        "tp1AtrMultiple": { "type": "number" },
        "tp2AtrMultiple": { "type": "number" },
        "tp3FibLevel": { "type": "number" },
        "slAtrMultiple": { "type": "number" },
        "minRRRatio": { "type": "number" },
        "trailingStopActivation": { "type": "string" },
        "trailActivationR": { "type": "number" },
        "timeBasedExitEnabled": { "type": "boolean" },
        "timeBasedExitCandles": { "type": "number" },
        "telegramBotToken": { "type": "string" },
        "telegramChatId": { "type": "string" },
        "binanceApiKey": { "type": "string" },
        "binanceApiSecret": { "type": "string" },
        "binanceTestnet": { "type": "boolean" },
        "alertOnNewSignal": { "type": "boolean" },
        "alertOnTradeExecuted": { "type": "boolean" },
        "alertOnTpHit": { "type": "boolean" },
        "alertOnSlHit": { "type": "boolean" },
        "alertOnTsMoved": { "type": "boolean" },
        "alertOnDailyLossLimit": { "type": "boolean" },
        "alertOnRangingDetected": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/positions/{positionId}": {
      "schema": "Position",
      "description": "Trading positions collection"
    },
    "/trade_logs/{tradeId}": {
      "schema": "TradeLog",
      "description": "Closed trades collection"
    },
    "/settings/{settingId}": {
      "schema": "BotSettings",
      "description": "Bot configuration document"
    }
  }
}
